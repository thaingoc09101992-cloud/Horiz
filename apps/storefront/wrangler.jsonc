{
  // TODO: this must match the exact name of your existing Cloudflare Workers
  // Builds project (Dashboard → your project → Settings → General). A
  // mismatch deploys to (or creates) a different Worker than the one
  // connected to this GitHub repo.
  "name": "horiz-storefront",
  "compatibility_date": "2026-08-26",
  // No "main" — this is a pure static build, nothing runs server-side.
  // `wrangler deploy` serves everything straight out of the assets dir.
  "assets": {
    "directory": "./dist",
    // All unmatched paths fall back to index.html so React Router's
    // client-side routes (e.g. /products/:id) resolve correctly — the
    // Worker-native equivalent of the public/_redirects catch-all.
    "not_found_handling": "single-page-application"
  }
}
